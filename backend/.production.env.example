# Backend production environment
#
# This file is used by docker compose for backend model / knowledge-base settings.
#
# Copy to `backend/.production.env` on the server or commit it in your private repo.

# App entrypoint
APP_BIND_IP=0.0.0.0
APP_PORT=2026

# Model / tool secrets
VOLCENGINE_API_KEY=replace-me
OPENAI_API_KEY=replace-me
# TAVILY_API_KEY=
# JINA_API_KEY=

# Qdrant configuration
QDRANT_MODE=local
QDRANT_LOCAL_PATH=.deer-flow/qdrant
# QDRANT_MODE=server
# QDRANT_URL=http://host.docker.internal:6333
# If this points to an SSH tunnel on the host, bind the tunnel to 0.0.0.0:6333
# or another host-reachable address so Docker containers can connect to it.
# QDRANT_API_KEY=replace-me
QDRANT_COLLECTION_NAME=knowledge_base
