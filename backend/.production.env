# MySQL container settings
MYSQL_DATABASE=history_rag
MYSQL_USER=history_rag
MYSQL_PASSWORD=replace-with-a-strong-mysql-user-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password

# Qdrant configuration
# Use local embedded Qdrant:
QDRANT_MODE=local
QDRANT_LOCAL_PATH=.deer-flow/qdrant
#
# Or use remote self-hosted Qdrant:
# QDRANT_MODE=server
# QDRANT_LOCAL_PATH=.deer-flow/qdrant
# QDRANT_URL=https://your-qdrant-host
# QDRANT_API_KEY=replace-with-your-qdrant-api-key
# QDRANT_COLLECTION_NAME=knowledge_base

# oss

OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
