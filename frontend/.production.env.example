# Frontend production environment
#
# Copy to `frontend/.production.env` on the server or commit it in your private repo.

BETTER_AUTH_SECRET=replace-with-a-random-long-secret
BETTER_AUTH_BASE_URL=http://your-domain-or-ip:2026
DATABASE_URL=mysql://history_rag:replace-me@mysql:3306/history_rag

# Optional direct URLs; keep commented to use nginx proxy
# NEXT_PUBLIC_BACKEND_BASE_URL=http://gateway:8001
# NEXT_PUBLIC_LANGGRAPH_BASE_URL=http://langgraph:2024
