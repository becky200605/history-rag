# Backend production environment
#
# This file is used by docker compose for:
# - MySQL container settings
# - backend model / knowledge-base settings
#
# Copy to `backend/.production.env` on the server or commit it in your private repo.

# App entrypoint
APP_BIND_IP=0.0.0.0
APP_PORT=2026

# Model / tool secrets
VOLCENGINE_API_KEY=replace-me
OPENAI_API_KEY=replace-me
# TAVILY_API_KEY=
# JINA_API_KEY=

# MySQL container settings
MYSQL_DATABASE=history_rag
MYSQL_USER=history_rag
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-password

# Qdrant configuration
QDRANT_MODE=local
QDRANT_LOCAL_PATH=.deer-flow/qdrant
# QDRANT_MODE=server
# QDRANT_URL=https://your-qdrant-host
# QDRANT_API_KEY=replace-me
QDRANT_COLLECTION_NAME=knowledge_base
