# Backend development environment
#
# Preferred backend env location for local development.
# Project-root `.env` is still accepted as a compatibility fallback,
# but new setups should use `backend/.env`.

# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# BAIDU_OCR_API_KEY=your-baidu-ocr-api-key
# BAIDU_OCR_SECRET_KEY=your-baidu-ocr-secret-key
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# Optional. Only used for display/debug; Baidu submission now uses signed OSS download URLs.
# OSS_UPLOAD_PREFIX=uploads
# OSS_SECURITY_TOKEN=

# Qdrant configuration for knowledge base
QDRANT_MODE=local
QDRANT_LOCAL_PATH=.deer-flow/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_base

# Local model credentials referenced by config.yaml; never commit real values.
# MINIMAX_API_KEY=
# DEEPSEEK_MODEL_API_KEY=
